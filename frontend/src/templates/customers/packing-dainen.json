{
  "id": "template_packing_dainen",
  "name": "装箱单-DAINEN专用",
  "type": "packing",
  "applicability": {
    "isDefault": false,
    "productTypes": [],
    "customerIds": [],
    "customerNames": ["DAINEN TRADING", "DAINEN"],
    "priority": 20
  },
  "blocks": [
    {
      "id": "block_company_header",
      "type": "company-header",
      "config": {
        "style": {
          "titleFontSize": 22,
          "borderBottom": true
        }
      }
    },
    {
      "id": "block_document_title",
      "type": "document-title",
      "config": {
        "text": "PACKING LIST",
        "style": {
          "fontSize": 18,
          "fontWeight": "bold",
          "textAlign": "center",
          "marginTop": 15,
          "marginBottom": 15
        }
      }
    },
    {
      "id": "block_order_info",
      "type": "order-info",
      "config": {
        "layout": "two-column",
        "fields": [
          {
            "position": "left",
            "label": "CONTRACT No:",
            "binding": "order.contractNoSpecial",
            "fallback": "order.contractNo"
          },
          {
            "position": "right",
            "label": "INVOICE NO:",
            "binding": "order.invoiceNo"
          },
          {
            "position": "left",
            "label": "DATE:",
            "binding": "order.invoiceDate"
          },
          {
            "position": "right",
            "label": "SHIPMENT DATE:",
            "binding": "order.shipmentDate"
          },
          {
            "position": "left",
            "label": "FROM:",
            "binding": "order.shipFrom"
          },
          {
            "position": "right",
            "label": "TO:",
            "binding": "order.shipTo"
          }
        ],
        "style": {
          "fontSize": 11
        }
      }
    },
    {
      "id": "block_customer_info",
      "type": "customer-info",
      "config": {
        "title": "ACCOUNT AND RISK OF:",
        "showAddress": true,
        "showContact": true
      }
    },
    {
      "id": "block_product_table",
      "type": "product-table",
      "config": {
        "columns": [
          {
            "header": "MARKS & NOS.",
            "binding": "",
            "width": "12%",
            "align": "center"
          },
          {
            "header": "DESCRIPTION & QUANTITY",
            "binding": "model",
            "width": "40%",
            "align": "left"
          },
          {
            "header": "PACKAGES",
            "binding": "packages",
            "width": "12%",
            "align": "center"
          },
          {
            "header": "QUANTITY",
            "binding": "quantity",
            "width": "12%",
            "align": "center",
            "suffix": "PCS"
          },
          {
            "header": "NET WEIGHT",
            "binding": "netWeight",
            "width": "12%",
            "align": "right",
            "suffix": "KGS"
          },
          {
            "header": "GROSS WEIGHT",
            "binding": "grossWeight",
            "width": "12%",
            "align": "right",
            "suffix": "KGS"
          }
        ],
        "descriptionFormat": "packing",
        "showProductCategory": true,
        "productCategory": "PP CONTAINER BAG",
        "showHeader": true,
        "headerStyle": {
          "background": "#f1f5f9",
          "fontWeight": "bold",
          "borderColor": "#333",
          "fontSize": 12
        },
        "rowStyle": {
          "borderColor": "#333",
          "fontSize": 11,
          "minHeight": 30
        },
        "showFooter": true,
        "footerConfig": {
          "labelColumn": 1,
          "labelColspan": 1,
          "showTotalQuantity": true,
          "totalQuantityColumn": 3,
          "showTotalPackages": true,
          "totalPackagesColumn": 2
        }
      }
    },
    {
      "id": "block_summary_info",
      "type": "summary-info",
      "config": {
        "layout": "two-column",
        "fields": [
          {
            "position": "left",
            "label": "TOTAL PACKAGES:",
            "binding": "calc.totalPackages"
          },
          {
            "position": "right",
            "label": "TOTAL QUANTITY:",
            "binding": "calc.totalQuantityPCS"
          }
        ]
      }
    },
    {
      "id": "block_signature",
      "type": "signature-area",
      "config": {
        "layout": "right",
        "label": "QINGDAO SHENGCHI PACKAGING PRODUCT CO.,LTD"
      }
    }
  ],
  "pageSettings": {
    "margin": {
      "top": 15,
      "bottom": 15,
      "left": 15,
      "right": 15
    }
  },
  "globalStyles": {
    "fontFamily": "Arial, \"Microsoft YaHei\", sans-serif",
    "fontSize": 11,
    "lineHeight": 1.4,
    "color": "#000"
  }
}

