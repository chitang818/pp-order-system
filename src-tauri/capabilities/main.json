{
  "$schema": "../gen/schemas/capabilities.json",
  "identifier": "main-capability",
  "description": "主窗口的文件保存和对话框权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-file",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}

