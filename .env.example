# 服务器端口配置
PORT=3000

# 运行环境：development / production
NODE_ENV=development

# 数据库文件路径（相对路径基于项目根目录）
# 也支持绝对路径，例如：D:\\path\\to\\erp.sqlite
DB_PATH=./data/erp.sqlite

# 会话过期（天）
SESSION_EXPIRY=7
REMEMBER_ME_EXPIRY=30

# 导出相关配置
PUPPETEER_TIMEOUT=30000
MAX_FILE_SIZE=50mb

# CORS 跨域配置（true/false 或具体域名）
# 例如：CORS_ORIGIN=http://127.0.0.1:3000
CORS_ORIGIN=true

# 注意：复制为 .env 使用，键=值 一行一个，# 开头行视为注释